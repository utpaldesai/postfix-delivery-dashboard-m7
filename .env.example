TZ=Asia/Kolkata
DB_NAME=postfix_reports
DB_USER=postfix_app
DB_PASSWORD=change-db-password
DB_ROOT_PASSWORD=change-root-password
WEB_USERNAME=admin
WEB_PASSWORD=change-web-password
WEB_PORT=8095
HOST_MAIL_LOG=/var/log/postfix.log
INITIAL_IMPORT_LINES=50000
RETENTION_DAYS=90

HOME_DOMAINS=change-home-domain.example

# SpamAssassin SQL user/domain/global preferences (maildb.userpref)
SPAM_PREF_DB_HOST=127.0.0.1
SPAM_PREF_DB_PORT=3306
SPAM_PREF_DB_NAME=maildb
SPAM_PREF_DB_USER=spam
SPAM_PREF_DB_PASSWORD=change-spam-pref-db-password

# Optional dedicated  SQL account.
# If omitted, the dashboard falls back to SPAM_PREF_DB_* above.

# Amavis quarantine management
AMAVIS_QUARANTINE_DIR=/var/lib/amavis/virusmails
AMAVIS_GID=130
# Host group GID owning /var/lib/amavis/logs/amavis.log (amavis:adm, mode 0640).
# Verify on host with: getent group adm
AMAVIS_LOG_GID=4
AMAVIS_PDP_SERVER=127.0.0.1:9998
QUARANTINE_LOOKBACK_DAYS=6
QUARANTINE_CACHE_REFRESH=300
QUARANTINE_ITEMS_PER_PAGE=20

AMAVIS_RELEASE_TIMEOUT=30
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DB_HOST_PORT=3307
DB_HOST=127.0.0.1
DB_PORT=3307
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=300
SESSION_COOKIE_NAME=postfix_dashboard_session
# Use true when dashboard is served over HTTPS. Set false only for controlled HTTP LAN deployments.
SESSION_COOKIE_SECURE=false

# Native Mail Size dashboard -> loopback-only host JSON helper.
MAIL_SIZE_API_URL=http://127.0.0.1/mail-size-api.php
MAIL_SIZE_API_KEY=
MAIL_SIZE_API_TIMEOUT=10

# Durable Postfix log reader checkpoint. The checkpoint itself is stored in
# ./data/reader and survives full-rebuild.sh.
INGEST_CHECKPOINT_FLUSH_SECONDS=2
INGEST_CHECKPOINT_FLUSH_LINES=100

# Milestone 6 SpamAssassin learning
# Mount the host SpamAssassin configuration read-only so sa-learn uses the same
# Bayes SQL settings as production Amavis/SpamAssassin.
SPAMASSASSIN_CONFIG_DIR=/etc/spamassassin
SA_LEARN_ENABLED=true
SA_LEARN_ON_MARK_SPAM=true
SA_LEARN_USER=amavis
SA_LEARN_TIMEOUT=90
SA_LEARN_MAX_SIZE=0

# Container process limit
APP_PIDS_LIMIT=256

# AI trainer branch (shadow-only; never participates in mail delivery decisions)
AI_TRAINER_ENABLED=true
AI_TRAINER_MIN_PER_CLASS=10
AI_TRAINER_MAX_FEATURES=2048
AI_TRAINER_TOKEN_BUCKETS=16384
AI_TRAINER_AUTO_TRAIN_AFTER_NEW_LABELS=250
AI_TRAINER_LOGISTIC_EPOCHS=12
AI_TRAINER_LOGISTIC_LR=0.08
AI_TRAINER_LOGISTIC_L2=0.0001
# Reserved future Amavis hook. Current release hard-disables decision coupling.
AI_AMAVIS_HOOK_MODE=disabled
AI_AMAVIS_HOOK_ENDPOINT=/api/ai/amavis-hook/v1

# Optional offline Geo-IP databases (MaxMind GeoLite2/GeoIP2 MMDB format).
# Place files under ./data/geoip; no external Geo-IP HTTP lookup is performed.
GEOIP_CITY_DB=/data/geoip/GeoLite2-City.mmdb
GEOIP_ASN_DB=/data/geoip/GeoLite2-ASN.mmdb
EMAIL_ANALYSIS_MAX_BYTES=2097152

# Email Analysis: dedicated Amavis/SpamAssassin analysis-only helper.
# Never point this at production Amavis SMTP 10024/10025 or PDP 9998.
AMAVIS_DRY_RUN_ENABLED=false
AMAVIS_DRY_RUN_HELPER_URL=http://127.0.0.1:10081/amavis-dry-run
AMAVIS_DRY_RUN_TIMEOUT=20
AMAVIS_DRY_RUN_ALLOW_REMOTE=false
AMAVIS_LOG_DIR=/var/lib/amavis/logs
AMAVIS_INGEST_SOURCE_KEY=production-amavis-log
AMAVIS_INGEST_BATCH_LINES=250
AMAVIS_INGEST_POLL_SECONDS=1

# Monitor tab - read-only authentication logs
DOVECOT_MAIL_LOG_FILE=/var/log/mail.log
ROUNDCUBE_LOGIN_LOG_FILE=/var/lib/roundcube/logs/userlogins.log
ROUNDCUBE_LOG_GID=33
MONITOR_LOG_TAIL_BYTES=2097152
MONITOR_LOG_MAX_LINES=10000
MONITOR_INGEST_BATCH_BYTES=1048576
MONITOR_SYNC_SECONDS=30
DB_POOL_SIZE=8
DB_POOL_WAIT_SECONDS=10

# AI hard-HAM emphasis; shadow trainer only.
AI_TRAINER_HARD_HAM_WEIGHT=1.75


# Only these immediate peers may supply X-Forwarded-For / X-Real-IP for audit identity.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# R1.1.39 continuous Postfix DB-backed feed
POSTFIX_INGEST_SOURCE_KEY=production-postfix-log
POSTFIX_INGEST_BATCH_LINES=250
POSTFIX_INGEST_POLL_SECONDS=0.5

# R1.1.45 local three-tier intelligence is self-contained and SHADOW ONLY.
# Campaign correlation uses locally observed quarantine fingerprints only.
AI_TI_CAMPAIGN_WINDOW_DAYS=30
